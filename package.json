{
  "name": "deploy-playground",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "cluster:deploy": "powershell -ExecutionPolicy Bypass -File cluster/deploy.ps1",
    "cluster:forward": "powershell -ExecutionPolicy Bypass -File cluster/forward.ps1",
    "cluster:down": "powershell -ExecutionPolicy Bypass -File cluster/down.ps1",
    "cluster:deploy:sh": "bash cluster/deploy.sh",
    "cluster:forward:sh": "bash cluster/forward.sh",
    "cluster:down:sh": "bash cluster/down.sh"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}